# ============================================================================
# 变量示例：复制为 terraform.tfvars 后按实际环境填写
# ============================================================================

region             = "cn-north-4"
project_name       = "scorekeep"
availability_zone  = "cn-north-4a"

# 对象存储桶名需全局唯一，请按需修改
obs_bucket_name = "scorekeep-practice-artifacts"

# 兼容接口实例管理员密码（请替换为强口令，部署完成后建议轮换）
geminidb_password = "<GEMINIDB_PASSWORD>"

# 被委托的云服务身份；承载应用的弹性云服务器固定为 op_svc_ecs
delegated_service_name = "op_svc_ecs"

# 业务通知邮箱；留空则不创建邮件订阅
notification_email = ""

# 运维公钥与私钥路径
ssh_public_key                = "ssh-ed25519 AAAA... your-key"
ssh_remote_private_key_path   = "C:/Users/<you>/.ssh/id_ed25519"
# 建议收敛为运维出口 IP/32
ssh_source_cidr               = "0.0.0.0/0"

# 计算与负载均衡规格（按区域可用规格与承载需要调整）
ecs_flavor             = "s6.large.2"
instance_count         = 1
l7_flavor_name         = "L7_flavor.elb.s1.small"
geminidb_spec_code     = "geminidb.cassandra.large.4"

# 变更该值可触发应用重新下发
app_revision = "1"
