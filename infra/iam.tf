# ============================================================================
# 身份层：计算实例委托
# ============================================================================
# 说明：
#   - 委托为实例提供运行期临时凭据，应用经实例元数据获取，避免长期密钥落盘。
#   - 应用只需发布业务通知，故仅授予消息通知服务的管理权限。
#   - 委托对兼容接口实例的数据面无授权作用，业务数据面使用实例自带账号。
#   - 产物桶由部署工具以操作者自身凭据访问，不经实例，故不在此授权。
# ============================================================================

resource "huaweicloud_identity_agency" "app_instance" {
  name                   = "${var.project_name}-ecs-agency"
  description            = "供应用实例发布业务通知事件"
  duration               = "FOREVER"
  delegated_service_name = "op_svc_ecs"

  project_role {
    project = var.region
    roles = [
      "SMN Administrator",
    ]
  }
}
